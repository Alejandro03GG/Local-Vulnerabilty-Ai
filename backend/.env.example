# Local Vulnerability AI - Backend Environment Configuration
# Copy to backend/.env for local development (never commit .env).
# Nested settings use VULN_AI_<SECTION>__<FIELD> (AI providers use an extra level).
#
# REQUIRED FOR LOCAL DEV: none beyond copying this file if you want overrides.
# Defaults in code work for SQLite + local API without a .env file.
#
# OPTIONAL: NVD API key, custom data dir, AI/Ollama, custom source URLs.

# --- Optional: Application Data Directory (default: ~/.local/share/vuln-ai)
# VULN_AI_DATA_DIR=/path/to/custom/data_dir

# --- Logging (optional; default INFO)
VULN_AI_LOG_LEVEL=INFO

# --- Database (optional; default sqlite under VULN_AI_DATA_DIR)
# VULN_AI_DATABASE__URL=sqlite+aiosqlite:///vuln_ai.db
# VULN_AI_DATABASE__ECHO=false

# --- CISA KEV Source (optional URL overrides)
VULN_AI_KEV__URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
VULN_AI_KEV__TIMEOUT_SECONDS=30
# VULN_AI_KEV__USER_AGENT=local-vulnerability-ai/1.1.3

# --- OSV Source
VULN_AI_OSV__BASE_URL=https://api.osv.dev/v1
VULN_AI_OSV__TIMEOUT_SECONDS=30.0

# --- NVD Source
VULN_AI_NVD__BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
VULN_AI_NVD__TIMEOUT_SECONDS=30.0
# OPTIONAL: improves NVD rate limits — use a placeholder locally, never commit a real key
# VULN_AI_NVD__API_KEY=your_optional_nvd_api_key

# --- AI layer (OPTIONAL; scanning continues when disabled or Ollama is offline)
VULN_AI_AI__ENABLED=true
VULN_AI_AI__OLLAMA__ENABLED=true
VULN_AI_AI__OLLAMA__BASE_URL=http://localhost:11434
VULN_AI_AI__OLLAMA__MODEL=llama3.2
VULN_AI_AI__OLLAMA__TEMPERATURE=0.0
VULN_AI_AI__OLLAMA__TIMEOUT_SECONDS=60
VULN_AI_AI__DECISION__ENABLED=true
VULN_AI_AI__DECISION__BASE_URL=http://localhost:11434
VULN_AI_AI__DECISION__MODEL=tev1:4b
VULN_AI_AI__DECISION__TIMEOUT_SECONDS=30

# --- API Settings
VULN_AI_API__HOST=127.0.0.1
VULN_AI_API__PORT=8000
VULN_AI_API__CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5176","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175","http://127.0.0.1:5176"]
