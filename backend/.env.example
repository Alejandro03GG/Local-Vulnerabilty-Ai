# Local Vulnerability AI - Backend Environment Configuration

# Application Data Directory (default: ~/.local/share/vuln-ai)
# VULN_AI_DATA_DIR=/path/to/custom/data_dir

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
VULN_AI_LOG_LEVEL=INFO

# Database Settings
# By default uses sqlite+aiosqlite:///${VULN_AI_DATA_DIR}/vuln_ai.db
# VULN_AI_DATABASE__URL=sqlite+aiosqlite:///vuln_ai.db
# VULN_AI_DATABASE__ECHO=false

# CISA KEV Source
VULN_AI_KEV__URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
VULN_AI_KEV__AUTO_SYNC=true
VULN_AI_KEV__SYNC_INTERVAL_HOURS=24

# OSV Source
VULN_AI_OSV__BASE_URL=https://api.osv.dev/v1
VULN_AI_OSV__TIMEOUT_SECONDS=30.0

# NVD Source
VULN_AI_NVD__BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
VULN_AI_NVD__TIMEOUT_SECONDS=30.0
# VULN_AI_NVD__API_KEY=your_optional_nvd_api_key


# AI & Decision Providers (Ollama)
VULN_AI_AI__OLLAMA_BASE_URL=http://localhost:11434
VULN_AI_AI__DEFAULT_MODEL=llama3.2
VULN_AI_AI__DECISION_MODEL=systemone
VULN_AI_AI__TIMEOUT_SECONDS=60.0

# API Settings
VULN_AI_API__HOST=127.0.0.1
VULN_AI_API__PORT=8000
VULN_AI_API__CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
